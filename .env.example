# SkillSwap AI Production SaaS Environment Variables Template

# Backend Server & Production MySQL Database
PORT=8080
SPRING_PROFILE=prod
DB_URL=jdbc:mysql://your-production-db-host:3306/skillswap_db?useSSL=true&serverTimezone=UTC
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# Security & JWT Configuration
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_ACCESS_EXPIRATION_MS=900000 # 15 minutes
JWT_REFRESH_EXPIRATION_MS=604800000 # 7 days

# Real Email OTP (Brevo / SendGrid / Gmail SMTP)
SPRING_MAIL_HOST=smtp-relay.brevo.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_brevo_smtp_login
SPRING_MAIL_PASSWORD=your_brevo_smtp_password

# Real Phone SMS OTP (Twilio Verify API)
TWILIO_ACCOUNT_SID=AC_your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_VERIFY_SERVICE_SID=VA_your_twilio_verify_service_sid

# Google OAuth2 Credentials
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# Razorpay Payments
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourKeySecretHere

# Cloudinary Media Upload
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# OpenAI API Key
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# Frontend Client URL Configuration
VITE_API_BASE_URL=https://skillswap-backend.onrender.com/api
